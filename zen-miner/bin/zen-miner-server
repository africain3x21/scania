#!/data/data/com.termux/files/usr/bin/bash
# Simple HTTP Server for zen-miner Dashboard

PORT=${1:-3000}
DASH_DIR="$HOME/zen-miner/dashboard"

mkdir -p "$DASH_DIR"

# Create HTML Dashboard
cat > "$DASH_DIR/index.html" <<'HTMLEND'
<!DOCTYPE html>
<html>
<head>
    <title>zen-miner Dashboard</title>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            font-family: 'Courier New', monospace;
            background: #0a0e27;
            color: #00ff00;
            padding: 20px;
        }
        .container {
            max-width: 1200px;
            margin: 0 auto;
        }
        header {
            text-align: center;
            margin-bottom: 30px;
            border-bottom: 2px solid #00ff00;
            padding-bottom: 20px;
        }
        h1 {
            font-size: 2.5em;
            text-shadow: 0 0 10px #00ff00;
        }
        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }
        .card {
            background: #1a1f3a;
            border: 2px solid #00ff00;
            padding: 20px;
            border-radius: 5px;
            box-shadow: 0 0 20px rgba(0, 255, 0, 0.1);
        }
        .card h2 {
            font-size: 1.3em;
            margin-bottom: 15px;
            color: #00ff00;
        }
        .status {
            font-size: 1.1em;
            margin: 10px 0;
        }
        .status.running { color: #00ff00; }
        .status.stopped { color: #ff4444; }
        .button {
            display: inline-block;
            background: #00ff00;
            color: #000;
            padding: 10px 20px;
            margin: 5px;
            border: none;
            border-radius: 3px;
            cursor: pointer;
            font-family: 'Courier New', monospace;
            font-weight: bold;
        }
        .button:hover {
            background: #00cc00;
        }
        .logs {
            background: #0a0e27;
            border: 2px solid #00ff00;
            padding: 15px;
            height: 300px;
            overflow-y: auto;
            margin-top: 20px;
            border-radius: 5px;
        }
        .log-line {
            margin: 5px 0;
            padding: 5px 0;
            border-bottom: 1px solid #00330000;
        }
        .timestamp {
            color: #00aaff;
        }
    </style>
</head>
<body>
    <div class="container">
        <header>
            <h1>⚡ zen-miner Dashboard</h1>
            <p>Termux Service Monitor</p>
        </header>
        
        <div class="grid">
            <div class="card">
                <h2>📊 Status</h2>
                <div id="status" class="status">Loading...</div>
                <div id="pid" class="status">PID: --</div>
                <div id="uptime" class="status">Uptime: --</div>
            </div>
            
            <div class="card">
                <h2>🖥️ System</h2>
                <div class="status">Device: <span id="device">--</span></div>
                <div class="status">Memory: <span id="memory">--</span></div>
                <div class="status">Time: <span id="time">--</span></div>
            </div>
            
            <div class="card">
                <h2>⚙️ Controls</h2>
                <button class="button" onclick="apiCall('start')">START</button>
                <button class="button" onclick="apiCall('stop')">STOP</button>
                <button class="button" onclick="apiCall('restart')">RESTART</button>
                <button class="button" onclick="location.reload()">REFRESH</button>
            </div>
        </div>
        
        <div class="card">
            <h2>📝 Recent Logs</h2>
            <div class="logs" id="logs">Loading logs...</div>
        </div>
    </div>
    
    <script>
        function updateDashboard() {
            fetch('/api/status')
                .then(r => r.json())
                .then(data => {
                    document.getElementById('status').textContent = data.running ? '✓ RUNNING' : '✗ STOPPED';
                    document.getElementById('status').className = 'status ' + (data.running ? 'running' : 'stopped');
                    document.getElementById('pid').textContent = 'PID: ' + (data.pid || '--');
                    document.getElementById('uptime').textContent = 'Uptime: ' + (data.uptime || '--') + 's';
                    document.getElementById('device').textContent = data.device || 'Unknown';
                    document.getElementById('memory').textContent = data.memory || '--';
                    document.getElementById('time').textContent = new Date().toLocaleTimeString();
                })
                .catch(e => console.error('Status error:', e));
            
            fetch('/api/logs')
                .then(r => r.json())
                .then(data => {
                    const logsDiv = document.getElementById('logs');
                    logsDiv.innerHTML = data.logs.map(log => 
                        `<div class="log-line"><span class="timestamp">${log}</span></div>`
                    ).join('');
                    logsDiv.scrollTop = logsDiv.scrollHeight;
                })
                .catch(e => console.error('Logs error:', e));
        }
        
        function apiCall(action) {
            fetch(`/api/${action}`, { method: 'POST' })
                .then(r => r.json())
                .then(data => {
                    alert(data.message);
                    updateDashboard();
                })
                .catch(e => alert('Error: ' + e));
        }
        
        updateDashboard();
        setInterval(updateDashboard, 3000);
    </script>
</body>
</html>
HTMLEND

echo "✓ Dashboard HTML created at $DASH_DIR/index.html"

# Start simple HTTP server
echo "Starting HTTP server on port $PORT..."
echo ""
echo "Dashboard: http://localhost:$PORT"
echo "Press Ctrl+C to stop"
echo ""

cd "$DASH_DIR"

if command -v python3 &>/dev/null; then
  python3 -m http.server $PORT
elif command -v python &>/dev/null; then
  python -m SimpleHTTPServer $PORT
else
  echo "Error: Python not found"
  echo "Install with: pkg install python3"
  exit 1
fi
